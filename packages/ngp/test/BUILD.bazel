load("//tools:defaults.bzl", "jasmine_test", "ts_project")

ts_project(
    name = "test_lib",
    testonly = True,
    srcs = glob(
        [
            "**/*_spec.ts",
            "*.ts",
        ],
        exclude = ["golden/**"],
    ),
    deps = [
        "//:node_modules/@types/jasmine",
        "//:node_modules/@types/node",
        "//:node_modules/diff",
        "//:node_modules/prettier",
        "//:node_modules/typescript",
        "//packages/compiler",
        "//packages/ngp",
    ],
)

jasmine_test(
    name = "test",
    data = [
        ":test_lib",
        "//packages/core:npm_package",
        "//packages/ngp/ng-analyze:ng_analyze_wasm",
    ] + glob(["golden/**"]),
)
